{% macro dropdown(is_multiselect, id, values, type) %}
<div id="{{ id }}" class="custom-select" data-name="{{ type }}">
  <div class="custom-select__trigger">
    <span class="custom-select__value">All</span>
    <span class="select-arrow" aria-hidden="true"
      >{{ inline_svg("assets/dropdown.svg") }}</span
    >
  </div>
  <ul class="custom-select__dropdown">
    {% if is_multiselect %}
    {% for value in values %}
    <li
      class="custom-select__option {% if value.slug in request.args.getlist(type) %}checked{% endif %}"
      data-value="{{ value.slug }}"
    >
      <span class="custom-select__checkbox"></span>
      {{ value.name }}
    </li>
    {% endfor %}
  </ul>
  {% for value in values %} {% if value.slug in request.args.getlist(type) %}<input
    type="hidden"
    name="{{ type }}"
    value="{{ value.slug }}"
  />{% endif %} {% endfor %}
</div>
    {% else %}
    <li
      class="custom-select__option {% if not request.args.get(type) %}selected{% endif %}"
      data-value=""
    >
      All
    </li>
    {% for value in values %}
    <li
      class="custom-select__option {% if request.args.get(value.type) == value.slug %}selected{% endif %}"
      data-value="{{ value.slug }}"
    >
      {{ value.name }}
    </li>
    {% endfor %} {% endif %}
  </ul>
  <input
    type="hidden"
    name="{{ type }}"
    value="{{ request.args.get(type, '') }}"
  />
</div>
{% endmacro %}
